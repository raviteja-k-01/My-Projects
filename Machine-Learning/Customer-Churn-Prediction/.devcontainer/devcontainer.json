{
  "name": "Customer churn (Python 3.11)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/Machine-Learning/Customer-Churn-Prediction",
  "customizations": {
    "codespaces": {"openFiles": ["Readme.md", "app/streamlit_app.py"]},
    "vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance"]}
  },
  "postCreateCommand": "python -m pip install -r requirements-dev.txt",
  "postAttachCommand": {"server": "python -m streamlit run app/streamlit_app.py"},
  "portsAttributes": {"8501": {"label": "Customer churn", "onAutoForward": "openPreview"}},
  "forwardPorts": [8501]
}
