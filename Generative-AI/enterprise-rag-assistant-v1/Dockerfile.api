# Local, single-replica RAG demo. Does not ship indexed BM25 or secrets.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/requirements.txt \
    && groupadd --gid 10001 rag \
    && useradd --uid 10001 --gid 10001 --create-home rag

COPY --chown=rag:rag src/ /app/src/
COPY --chown=rag:rag scripts/deployment_preflight.py /app/scripts/deployment_preflight.py

USER rag
EXPOSE 8000
# Fail closed if required env vars or mounted BM25 index are invalid.
# Does not contact Gemini or Qdrant during preflight.
CMD ["sh", "-c", "python -m scripts.deployment_preflight && exec python -m uvicorn src.api.app:app --host 0.0.0.0 --port 8000"]
