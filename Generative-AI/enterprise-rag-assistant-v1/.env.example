# Copy to the gitignored .env and supply your authorized credentials locally.
GEMINI_API_KEY=replace_locally
QDRANT_URL=https://your-qdrant-host
QDRANT_API_KEY=replace_locally

# Optional authorized second credential. Never rotated automatically.
# GEMINI_API_KEY_1=replace_locally
GEMINI_EMBEDDING_KEY_ENV=GEMINI_API_KEY
GEMINI_GENERATION_KEY_ENV=GEMINI_API_KEY
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_GENERATION_MAX_ATTEMPTS=1
GEMINI_GENERATION_TIMEOUT_SECONDS=120
GEMINI_GENERATION_MAX_OUTPUT_TOKENS=1024
# Set blank for a model that does not support thinking_level.
GEMINI_GENERATION_THINKING_LEVEL=low
RAG_RATE_LIMIT_PER_MINUTE=12
