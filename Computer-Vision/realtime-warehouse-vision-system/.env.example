APP_ENV=development
APP_NAME=VisionTrack Dynamic Pallet System

DB_ENABLED=true
DB_TARGET=local

LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=visiontrack_local
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=

CLOUD_DB_HOST=your-cloud-db-host
CLOUD_DB_PORT=3306
CLOUD_DB_NAME=your-cloud-db-name
CLOUD_DB_USER=your-cloud-db-user
CLOUD_DB_PASSWORD=

MODEL_PATH=models/dynamic_pallet_best.pt
INPUT_VIDEO_DIR=data/input_videos
MASTER_DATA_DIR=data/master
OUTPUT_DATA_DIR=outputs/csv
OUTPUT_VIDEO_DIR=outputs/videos
LOG_DIR=outputs/logs